---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "ООО Альянс — оптовые поставки соли",
    description = "Оптовые поставки пищевой, технической и таблетированной соли, противогололедных реагентов. Работаем с бизнесом и предприятиями, доставка по регионам.",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
</head>
<body>
<slot />
</body>
</html>