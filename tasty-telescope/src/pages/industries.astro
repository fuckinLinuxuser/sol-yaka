---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

const industries = [
    "Производственные предприятия",
    "Пищевая отрасль",
    "Водоподготовка и инженерные системы",
    "Склады и логистические комплексы",
    "Дорожные и коммунальные службы",
    "Оптовые и снабженческие компании",
];
---

<BaseLayout title="Отрасли — ООО Альянс">
    <Header />

    <main class="inner-page">
        <section class="inner-hero">
            <div class="container">
                <span class="inner-hero__eyebrow">Отрасли</span>
                <h1 class="inner-hero__title">С кем мы работаем</h1>
                <p class="inner-hero__text">
                    Работаем с B2B-клиентами, которым важны понятные условия, документы,
                    стабильные поставки и быстрое согласование заявки.
                </p>
            </div>
        </section>

        <section class="inner-section">
            <div class="container">
                <div class="industry-list">
                    {industries.map((item) => (
                            <article class="industry-item">
                                <h2 class="industry-item__title">{item}</h2>
                                <p class="industry-item__text">
                                    Подбираем формат поставки, объёмы и условия под задачи конкретной
                                    отрасли и объекта.
                                </p>
                            </article>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .inner-page {
        padding-top: 122px;
    }

    .inner-hero {
        padding: 72px 0 36px;
        background: linear-gradient(180deg, rgba(248, 250, 252, 0.95) 0%, #ffffff 100%);
    }

    .inner-hero__eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .inner-hero__title {
        margin: 0;
        font-size: clamp(40px, 5vw, 64px);
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .inner-hero__text {
        max-width: 760px;
        margin: 18px 0 0;
        font-size: 18px;
        color: var(--color-text-soft);
    }

    .inner-section {
        padding: 24px 0 96px;
    }

    .industry-list {
        display: grid;
        gap: 18px;
    }

    .industry-item {
        padding: 26px 28px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
    }

    .industry-item__title {
        margin: 0 0 10px;
        font-size: 24px;
        line-height: 1.15;
    }

    .industry-item__text {
        margin: 0;
        color: var(--color-text-soft);
    }

    @media (max-width: 720px) {
        .inner-page {
            padding-top: 88px;
        }

        .inner-hero {
            padding: 44px 0 24px;
        }

        .industry-item {
            padding: 22px;
        }
    }
</style>