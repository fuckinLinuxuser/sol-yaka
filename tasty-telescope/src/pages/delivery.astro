---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

const steps = [
    "Получаем заявку и уточняем параметры поставки",
    "Подбираем формат продукции и согласовываем объём",
    "Формируем коммерческое предложение и документы",
    "Организуем отгрузку и сопровождаем поставку",
];
---

<BaseLayout title="Доставка — ООО Альянс">
    <Header />

    <main class="inner-page">
        <section class="inner-hero">
            <div class="container">
                <span class="inner-hero__eyebrow">Доставка</span>
                <h1 class="inner-hero__title">Поставка без лишних сложностей</h1>
                <p class="inner-hero__text">
                    Подбираем формат отгрузки и маршрут под ваш объект, сроки и объём
                    закупки.
                </p>
            </div>
        </section>

        <section class="inner-section">
            <div class="container">
                <div class="delivery-steps">
                    {steps.map((step, index) => (
                            <article class="delivery-step">
                                <span class="delivery-step__number">{index + 1}</span>
                                <h2 class="delivery-step__title">{step}</h2>
                            </article>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .inner-page {
        padding-top: 122px;
    }

    .inner-hero {
        padding: 72px 0 36px;
        background: linear-gradient(180deg, rgba(248, 250, 252, 0.95) 0%, #ffffff 100%);
    }

    .inner-hero__eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .inner-hero__title {
        margin: 0;
        font-size: clamp(40px, 5vw, 64px);
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .inner-hero__text {
        max-width: 760px;
        margin: 18px 0 0;
        font-size: 18px;
        color: var(--color-text-soft);
    }

    .inner-section {
        padding: 24px 0 96px;
    }

    .delivery-steps {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .delivery-step {
        padding: 28px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
    }

    .delivery-step__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        margin-bottom: 16px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--color-primary) 0%, #3b82f6 100%);
        color: #ffffff;
        font-weight: 800;
    }

    .delivery-step__title {
        margin: 0;
        font-size: 24px;
        line-height: 1.15;
    }

    @media (max-width: 720px) {
        .inner-page {
            padding-top: 88px;
        }

        .inner-hero {
            padding: 44px 0 24px;
        }

        .delivery-steps {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .delivery-step {
            padding: 22px;
        }
    }
</style>