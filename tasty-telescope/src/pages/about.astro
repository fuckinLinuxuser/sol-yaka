---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

const facts = [
    {
        label: "Год основания",
        value: "2006",
        text: "Работаем на рынке поставок с 6 марта 2006 года.",
    },
    {
        label: "География",
        value: "20 регионов",
        text: "Поставки и логистические решения для клиентов по России.",
    },
    {
        label: "Формат работы",
        value: "B2B",
        text: "Ориентируемся на предприятия, торговые компании и промышленный сектор.",
    },
    {
        label: "Подход",
        value: "Надёжность",
        text: "Строим работу на понятных условиях, стабильных поставках и долгосрочном сотрудничестве.",
    },
];

const directions = [
    "Пищевая соль",
    "Техническая соль",
    "Таблетированная соль",
    "Противогололёдные материалы",
];

const details = [
    {
        key: "Полное наименование",
        value: "Общество с ограниченной ответственностью «Альянс»",
    },
    {
        key: "Краткое наименование",
        value: "ООО «Альянс»",
    },
    {
        key: "Генеральный директор",
        value: "Боголюбов Павел Анатольевич",
    },
    {
        key: "ОГРН",
        value: "1066027015537",
    },
    {
        key: "ИНН",
        value: "6027094141",
    },
    {
        key: "КПП",
        value: "602701001",
    },
    {
        key: "Юридический адрес",
        value: "Псковская область, г. Псков, ул. Фрунзе, д. 32А",
    },
];
---

<BaseLayout
        title="О компании — ООО Альянс"
        description="Информация о компании ООО Альянс: история, направления поставок, руководство и реквизиты."
>
    <Header />

    <main class="about-page">
        <section class="about-hero">
            <div class="container about-hero__container">
                <div class="about-hero__content">
                    <span class="about-hero__eyebrow">О компании</span>

                    <h1 class="about-hero__title">
                        ООО «Альянс» — надёжный поставщик соли для бизнеса
                    </h1>

                    <p class="about-hero__subtitle">
                        Мы работаем с предприятиями, торговыми компаниями и промышленными
                        заказчиками, выстраивая поставки как понятный и стабильный
                        бизнес-процесс: от подбора продукции до логистики и регулярных
                        отгрузок.
                    </p>

                    <div class="about-hero__actions">
                        <a href="#company-details" class="btn btn--primary">Реквизиты компании</a>
                        <a href="/contacts" class="btn btn--secondary">Связаться с нами</a>
                    </div>
                </div>

                <div class="about-hero__panel">
                    <div class="about-hero__panel-inner">
                        <span class="about-hero__panel-label">Руководство</span>
                        <h2>Генеральный директор</h2>
                        <p class="about-hero__director">Боголюбов Павел Анатольевич</p>
                        <p class="about-hero__panel-text">
                            Компания работает на рынке с 2006 года и ориентируется на
                            долгосрочное сотрудничество, надёжность поставок и удобное
                            взаимодействие с клиентами.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="about-story">
            <div class="container about-story__container">
                <div class="section-heading">
                    <span class="section-heading__eyebrow">Кто мы</span>
                    <h2 class="section-heading__title">О компании ООО «Альянс»</h2>
                </div>

                <div class="about-story__grid">
                    <div class="about-story__text card">
                        <p class="about-story__lead">
                            ООО «Альянс» — российская компания из Пскова, зарегистрированная в
                            2006 году и работающая в сфере оптовых поставок продукции для
                            предприятий и бизнеса.
                        </p>

                        <div class="about-story__paragraphs">
                            <p>
                                Основное направление работы компании — поставки соли и
                                сопутствующей продукции для производственных, технических,
                                торговых и инженерных задач. Мы строим работу так, чтобы клиент
                                получал не просто товар, а понятное решение по снабжению.
                            </p>

                            <p>
                                Для нас важны стабильность отгрузок, прозрачные условия
                                сотрудничества, предсказуемая логистика и аккуратная работа с
                                заказами любого масштаба — от регулярных поставок до долгосрочных
                                контрактов.
                            </p>

                            <p>
                                Мы ориентируемся на практичный подход: подобрать нужный тип
                                продукции, согласовать удобный формат поставки и обеспечить
                                надёжное сопровождение на всех этапах взаимодействия.
                            </p>
                        </div>
                    </div>

                    <div class="about-story__facts">
                        {facts.map((item) => (
                                <article class="about-fact card">
                                    <span class="about-fact__label">{item.label}</span>
                                    <strong class="about-fact__value">{item.value}</strong>
                                    <p class="about-fact__text">{item.text}</p>
                                </article>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <section class="about-directions">
            <div class="container">
                <div class="section-heading section-heading--center">
                    <span class="section-heading__eyebrow">Направления</span>
                    <h2 class="section-heading__title">Что поставляет компания</h2>
                    <p class="section-heading__text">
                        ООО «Альянс» работает с продукцией, востребованной в производстве,
                        торговле, водоподготовке и техническом применении.
                    </p>
                </div>

                <div class="about-directions__grid">
                    {directions.map((item) => (
                            <div class="about-direction card">
                                <span class="about-direction__dot"></span>
                                <h3>{item}</h3>
                            </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="about-details" id="company-details">
            <div class="container about-details__container">
                <div class="section-heading">
                    <span class="section-heading__eyebrow">Реквизиты</span>
                    <h2 class="section-heading__title">Официальная информация</h2>
                    <p class="section-heading__text">
                        Базовые сведения о компании для партнёров, клиентов и делового
                        взаимодействия.
                    </p>
                </div>

                <div class="about-details__card card">
                    <dl class="about-details__list">
                        {details.map((item) => (
                                <div class="about-details__row">
                                    <dt>{item.key}</dt>
                                    <dd>{item.value}</dd>
                                </div>
                        ))}
                    </dl>
                </div>
            </div>
        </section>

        <section class="about-cta">
            <div class="container">
                <div class="about-cta__box">
                    <div class="about-cta__content">
                        <span class="about-cta__eyebrow">Сотрудничество</span>
                        <h2>Готовы обсудить поставку продукции для вашего бизнеса</h2>
                        <p>
                            Свяжитесь с нами, чтобы обсудить формат работы, объёмы поставок и
                            удобные условия сотрудничества.
                        </p>
                    </div>

                    <div class="about-cta__actions">
                        <a href="/contacts" class="btn btn--light">Оставить заявку</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .about-page {
        background:
                radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 30%),
                linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
    }

    .card {
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.06);
        backdrop-filter: blur(8px);
    }

    .section-heading {
        max-width: 760px;
        margin-bottom: 32px;
    }

    .section-heading--center {
        margin: 0 auto 32px;
        text-align: center;
    }

    .section-heading__eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.08);
        color: #2563eb;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .section-heading__title {
        margin: 0 0 14px;
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1.08;
        letter-spacing: -0.04em;
        color: #0f172a;
    }

    .section-heading__text {
        margin: 0;
        font-size: 17px;
        line-height: 1.75;
        color: #475569;
    }

    .about-hero {
        padding: 96px 0 64px;
    }

    .about-hero__container {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
        gap: 28px;
        align-items: stretch;
    }

    .about-hero__content {
        padding: 28px 0;
    }

    .about-hero__eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.08);
        color: #2563eb;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .about-hero__title {
        margin: 0 0 18px;
        font-size: clamp(38px, 5vw, 64px);
        line-height: 0.98;
        letter-spacing: -0.05em;
        color: #0f172a;
        max-width: 820px;
    }

    .about-hero__subtitle {
        margin: 0;
        max-width: 760px;
        font-size: 18px;
        line-height: 1.8;
        color: #475569;
    }

    .about-hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 32px;
    }

    .about-hero__panel {
        height: 100%;
    }

    .about-hero__panel-inner {
        height: 100%;
        padding: 32px;
        border-radius: 28px;
        background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(239, 246, 255, 0.96) 100%);
        border: 1px solid rgba(37, 99, 235, 0.14);
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .about-hero__panel-label {
        display: inline-flex;
        align-self: flex-start;
        margin-bottom: 14px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.08);
        color: #2563eb;
        font-size: 13px;
        font-weight: 700;
    }

    .about-hero__panel h2 {
        margin: 0 0 10px;
        font-size: 20px;
        line-height: 1.3;
        color: #64748b;
        font-weight: 600;
    }

    .about-hero__director {
        margin: 0 0 18px;
        font-size: 28px;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: #0f172a;
        font-weight: 800;
    }

    .about-hero__panel-text {
        margin: 0;
        font-size: 16px;
        line-height: 1.75;
        color: #475569;
    }

    .about-story {
        padding: 32px 0 64px;
    }

    .about-story__grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
        gap: 28px;
        align-items: start;
    }

    .about-story__text {
        padding: 32px;
    }

    .about-story__lead {
        margin: 0 0 20px;
        font-size: 24px;
        line-height: 1.6;
        letter-spacing: -0.02em;
        font-weight: 700;
        color: #0f172a;
    }

    .about-story__paragraphs {
        display: grid;
        gap: 16px;
    }

    .about-story__paragraphs p {
        margin: 0;
        font-size: 16px;
        line-height: 1.8;
        color: #475569;
    }

    .about-story__facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .about-fact {
        padding: 22px;
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .about-fact__label {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #2563eb;
    }

    .about-fact__value {
        display: block;
        margin: 10px 0;
        font-size: 28px;
        line-height: 1.1;
        letter-spacing: -0.03em;
        color: #0f172a;
    }

    .about-fact__text {
        margin: 0;
        font-size: 14px;
        line-height: 1.65;
        color: #64748b;
    }

    .about-directions {
        padding: 32px 0 64px;
    }

    .about-directions__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .about-direction {
        padding: 26px 22px;
        text-align: left;
    }

    .about-direction__dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: #2563eb;
        box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.12);
        margin-bottom: 18px;
    }

    .about-direction h3 {
        margin: 0;
        font-size: 20px;
        line-height: 1.35;
        color: #0f172a;
    }

    .about-details {
        padding: 32px 0 80px;
    }

    .about-details__card {
        padding: 8px 28px;
    }

    .about-details__list {
        margin: 0;
    }

    .about-details__row {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 24px;
        padding: 22px 0;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    }

    .about-details__row:last-child {
        border-bottom: none;
    }

    .about-details__row dt {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #64748b;
    }

    .about-details__row dd {
        margin: 0;
        font-size: 16px;
        line-height: 1.75;
        color: #0f172a;
    }

    .about-cta {
        padding: 0 0 96px;
    }

    .about-cta__box {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: center;
        padding: 36px;
        border-radius: 28px;
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 55%, #3b82f6 100%);
        box-shadow: 0 24px 60px rgba(37, 99, 235, 0.28);
    }

    .about-cta__content {
        max-width: 720px;
    }

    .about-cta__eyebrow {
        display: inline-flex;
        margin-bottom: 14px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .about-cta__content h2 {
        margin: 0 0 14px;
        font-size: clamp(28px, 4vw, 42px);
        line-height: 1.08;
        letter-spacing: -0.04em;
        color: #ffffff;
    }

    .about-cta__content p {
        margin: 0;
        font-size: 17px;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.88);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 0 22px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn--primary {
        background: #2563eb;
        color: #ffffff;
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.22);
    }

    .btn--primary:hover {
        background: #1d4ed8;
    }

    .btn--secondary {
        background: #ffffff;
        color: #0f172a;
        border: 1px solid rgba(148, 163, 184, 0.24);
    }

    .btn--light {
        background: #ffffff;
        color: #1d4ed8;
        min-width: 200px;
    }

    @media (max-width: 1100px) {
        .about-hero__container,
        .about-story__grid {
            grid-template-columns: 1fr;
        }

        .about-directions__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .about-cta__box {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @media (max-width: 767px) {
        .about-hero {
            padding: 72px 0 48px;
        }

        .about-story,
        .about-directions,
        .about-details {
            padding-top: 24px;
            padding-bottom: 56px;
        }

        .about-cta {
            padding-bottom: 72px;
        }

        .about-hero__subtitle,
        .section-heading__text,
        .about-cta__content p {
            font-size: 16px;
            line-height: 1.7;
        }

        .about-hero__panel-inner,
        .about-story__text,
        .about-details__card,
        .about-cta__box {
            padding: 24px;
        }

        .about-story__lead {
            font-size: 20px;
        }

        .about-story__facts,
        .about-directions__grid {
            grid-template-columns: 1fr;
        }

        .about-details__row {
            grid-template-columns: 1fr;
            gap: 8px;
            padding: 18px 0;
        }

        .about-hero__actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn,
        .btn--light,
        .btn--secondary,
        .btn--primary {
            width: 100%;
        }
    }
</style>