---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import IntroHero from "../components/home/IntroHero.astro";
import ProductsSection from "../components/home/ProductsSection.astro";
import AboutCompanySection from "../components/home/AboutCompanySection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import BenefitsSection from "../components/home/BenefitsSection.astro";
import IndustriesSection from "../components/home/IndustriesSection.astro";
import VacanciesSection from "../components/home/VacanciesSection.astro";
import FinalCtaSection from "../components/home/FinalCtaSection.astro";
---

<BaseLayout
    title="ООО Альянс — оптовые поставки соли"
    description="Оптовые поставки пищевой, технической и таблетированной соли, противогололедных реагентов. Работаем с бизнесом и предприятиями, доставка по регионам."
>
  <main>
    <IntroHero />
    <Header />
    <ProductsSection />
    <AboutCompanySection />
    <ContactSection />
    <BenefitsSection />
    <IndustriesSection />
    <VacanciesSection />
    <FinalCtaSection />
  </main>

  <Footer />
</BaseLayout>