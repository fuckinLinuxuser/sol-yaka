---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

const pageTitle = "Контакты";
const pageDescription =
    "Контакты ООО «Альянс»: телефоны, email, график работы и адрес компании в Пскове.";

const contactItems = [
    {
        label: "Компания",
        value: "ООО «Альянс»",
        href: "",
    },
    {
        label: "Телефон",
        value: "8 (8112) 70-25-29",
        href: "tel:+78112702529",
    },
    {
        label: "Мобильный",
        value: "8 (921) 508-01-90",
        href: "tel:+79215080190",
    },
    {
        label: "Email",
        value: "pskov@e-salt.ru",
        href: "mailto:pskov@e-salt.ru",
    },
    {
        label: "Адрес",
        value: "Псков, ул. Фрунзе, д. 32А",
        href: "",
    },
    {
        label: "График работы",
        value: "Пн–Пт: 08:00–17:00",
        href: "",
    },
];

const mapWidgetUrl =
    "https://yandex.ru/map-widget/v1/?um=constructor%3Af0be3ae20fe7537ff998261033af698f6bfbfae4789c98233f848961a3f5bd1b&source=constructor";

const mapPageUrl =
    "https://yandex.com/maps/25/pskov/?from=mapframe&ll=28.384000%2C57.756499&mode=usermaps&source=mapframe&um=constructor%3Af0be3ae20fe7537ff998261033af698f6bfbfae4789c98233f848961a3f5bd1b&utm_source=mapframe&z=16";
---

<BaseLayout title={`${pageTitle} | ООО «Альянс»`} description={pageDescription}>
    <Header />

    <main class="contacts-page">
        <section class="contacts-hero">
            <div class="container">
                <p class="contacts-hero__eyebrow">Контакты</p>
                <h1 class="contacts-hero__title">Свяжитесь с ООО «Альянс»</h1>
                <p class="contacts-hero__text">
                    Поможем с подбором продукции, расчётом заказа, условиями поставки и
                    ответим на вопросы по сотрудничеству.
                </p>
            </div>
        </section>

        <section class="contacts-section">
            <div class="container">
                <div class="contacts-grid">
                    <div class="contacts-card">
                        <div class="contacts-card__header">
                            <p class="contacts-card__eyebrow">Контактная информация</p>
                            <h2 class="contacts-card__title">Работаем с оптовыми заказами</h2>
                            <p class="contacts-card__text">
                                Консультируем по ассортименту, логистике, срокам и формату
                                поставок для бизнеса и предприятий.
                            </p>
                        </div>

                        <div class="contacts-list">
                            {contactItems.map((item) => (
                                    <div class="contacts-item">
                                        <span class="contacts-item__label">{item.label}</span>

                                        {item.href ? (
                                                <a
                                                        class="contacts-item__value contacts-item__value--link"
                                                        href={item.href}
                                                >
                                                    {item.value}
                                                </a>
                                        ) : (
                                                <span class="contacts-item__value">{item.value}</span>
                                        )}
                                    </div>
                            ))}
                        </div>

                        <div class="contacts-actions">
                            <a
                                    class="contacts-button contacts-button--primary"
                                    href="tel:+78112702529"
                            >
                                Позвонить
                            </a>

                            <a
                                    class="contacts-button contacts-button--secondary"
                                    href="mailto:pskov@e-salt.ru"
                            >
                                Написать на почту
                            </a>
                        </div>
                    </div>

                    <div class="contacts-card contacts-card--map">
                        <div class="contacts-card__header">
                            <p class="contacts-card__eyebrow">Карта</p>
                            <h2 class="contacts-card__title">Мы на Яндекс Картах</h2>
                            <p class="contacts-card__text">
                                Откройте карту, чтобы быстро построить маршрут до компании.
                            </p>
                        </div>

                        <div class="contacts-map">
                            <iframe
                                    src={mapWidgetUrl}
                                    title="Карта расположения ООО Альянс"
                                    width="100%"
                                    height="520"
                                    frameborder="0"
                                    allowfullscreen
                                    loading="lazy"
                            ></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .contacts-page {
        background:
                radial-gradient(circle at top, rgba(38, 92, 160, 0.08), transparent 32%),
                linear-gradient(180deg, #f7f9fc 0%, #ffffff 100%);
        color: #142033;
    }

    .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
    }

    .contacts-hero {
        padding: 72px 0 28px;
    }

    .contacts-hero__eyebrow {
        margin: 0 0 12px;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #3f6ea5;
    }

    .contacts-hero__title {
        margin: 0 0 16px;
        max-width: 720px;
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
        color: #0f1728;
    }

    .contacts-hero__text {
        margin: 0;
        max-width: 760px;
        font-size: 1.05rem;
        line-height: 1.7;
        color: #526176;
    }

    .contacts-section {
        padding: 0 0 88px;
    }

    .contacts-grid {
        display: grid;
        grid-template-columns: minmax(320px, 460px) minmax(320px, 1fr);
        gap: 28px;
        align-items: start;
    }

    .contacts-card {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(21, 40, 70, 0.08);
        border-radius: 28px;
        box-shadow: 0 24px 60px rgba(15, 23, 40, 0.08);
        padding: 32px;
        backdrop-filter: blur(8px);
    }

    .contacts-card--map {
        overflow: hidden;
    }

    .contacts-card__header {
        margin-bottom: 24px;
    }

    .contacts-card__eyebrow {
        margin: 0 0 10px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #5f7ea6;
    }

    .contacts-card__title {
        margin: 0 0 12px;
        font-size: clamp(1.4rem, 2.2vw, 2rem);
        line-height: 1.2;
        color: #0f1728;
    }

    .contacts-card__text {
        margin: 0;
        font-size: 0.98rem;
        line-height: 1.7;
        color: #5a6779;
    }

    .contacts-list {
        display: grid;
        gap: 16px;
    }

    .contacts-item {
        display: grid;
        gap: 6px;
        padding: 16px 0;
        border-bottom: 1px solid rgba(21, 40, 70, 0.08);
    }

    .contacts-item:first-child {
        padding-top: 0;
    }

    .contacts-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .contacts-item__label {
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #6e7f95;
    }

    .contacts-item__value {
        font-size: 1.05rem;
        line-height: 1.5;
        color: #142033;
    }

    .contacts-item__value--link {
        text-decoration: none;
        color: #1d4f91;
        transition:
                color 0.2s ease,
                opacity 0.2s ease;
    }

    .contacts-item__value--link:hover {
        color: #14396b;
        opacity: 0.9;
    }

    .contacts-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 28px;
    }

    .contacts-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 22px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                background-color 0.2s ease,
                color 0.2s ease,
                border-color 0.2s ease;
    }

    .contacts-button:hover {
        transform: translateY(-1px);
    }

    .contacts-button--primary {
        background: #1d4f91;
        color: #ffffff;
        box-shadow: 0 14px 32px rgba(29, 79, 145, 0.22);
    }

    .contacts-button--primary:hover {
        background: #163f73;
    }

    .contacts-button--secondary {
        border: 1px solid rgba(29, 79, 145, 0.18);
        background: #ffffff;
        color: #1d4f91;
    }

    .contacts-button--secondary:hover {
        border-color: rgba(29, 79, 145, 0.34);
        background: #f4f8fc;
    }

    .contacts-map {
        overflow: hidden;
        border-radius: 22px;
        height: 520px;
        border: 1px solid rgba(21, 40, 70, 0.08);
        background: #eef3f9;
    }

    .contacts-map iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .contacts-map__link {
        display: inline-flex;
        align-items: center;
        margin-top: 16px;
        width: fit-content;
        text-decoration: none;
        font-weight: 700;
        color: #1d4f91;
    }

    .contacts-map__link:hover {
        color: #14396b;
    }

    @media (max-width: 960px) {
        .contacts-hero {
            padding-top: 56px;
        }

        .contacts-grid {
            grid-template-columns: 1fr;
        }

        .contacts-map {
            height: 420px;
        }
    }

    @media (max-width: 640px) {
        .container {
            width: min(100% - 24px, 1180px);
        }

        .contacts-hero {
            padding-top: 40px;
            padding-bottom: 20px;
        }

        .contacts-card {
            padding: 22px 18px;
            border-radius: 22px;
        }

        .contacts-actions {
            flex-direction: column;
        }

        .contacts-button {
            width: 100%;
        }

        .contacts-map {
            height: 340px;
            border-radius: 18px;
        }
    }
</style>