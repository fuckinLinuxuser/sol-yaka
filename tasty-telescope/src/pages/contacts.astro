---
const pageTitle = "Контакты";
---

<section class="contacts-page">
    <div class="contacts-page__container">
        <div class="contacts-page__header">
            <p class="contacts-page__eyebrow">Контакты</p>
            <h1 class="contacts-page__title">{pageTitle}</h1>
            <p class="contacts-page__subtitle">
                Свяжитесь с нами удобным способом. Поможем с подбором продукции,
                условиями поставки и расчётом заказа.
            </p>
        </div>

        <div class="contacts-page__grid">
            <div class="contacts-card">
                <div class="contacts-card__top">
                    <h2 class="contacts-card__title">Контактная информация</h2>
                    <p class="contacts-card__text">
                        Работаем с оптовыми заказами и отвечаем на вопросы по ассортименту,
                        логистике и условиям сотрудничества.
                    </p>
                </div>

                <div class="contacts-list">
                    <div class="contacts-item">
                        <span class="contacts-item__label">Компания</span>
                        <p class="contacts-item__value">ООО «Альянс»</p>
                    </div>

                    <div class="contacts-item">
                        <span class="contacts-item__label">Телефон</span>
                        <a class="contacts-item__link" href="tel:+70000000000">
                            +7 (000) 000-00-00
                        </a>
                    </div>

                    <div class="contacts-item">
                        <span class="contacts-item__label">Email</span>
                        <a class="contacts-item__link" href="mailto:info@example.ru">
                            info@example.ru
                        </a>
                    </div>

                    <div class="contacts-item">
                        <span class="contacts-item__label">Адрес</span>
                        <p class="contacts-item__value">Псков, ул. Примерная, д. 1</p>
                    </div>

                    <div class="contacts-item">
                        <span class="contacts-item__label">График работы</span>
                        <p class="contacts-item__value">Пн–Пт: 09:00–18:00</p>
                    </div>
                </div>
            </div>

            <div class="map-card">
                <div class="map-card__header">
                    <h2 class="map-card__title">Мы на карте</h2>
                    <p class="map-card__text">
                        Точка компании на Яндекс Картах для быстрого построения маршрута.
                    </p>
                </div>

                <div class="map-card__frame">
                    <iframe
                            src="https://yandex.ru/map-widget/v1/?um=constructor%3Af0be3ae20fe7537ff998261033af698f6bfbfae4789c98233f848961a3f5bd1b&source=constructor"
                            width="100%"
                            height="100%"
                            frameborder="0"
                            allowfullscreen
                            loading="lazy"
                            title="Карта с местоположением компании"
                    ></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contacts-page {
        padding: 72px 0 96px;
        background:
                radial-gradient(circle at top left, rgba(111, 126, 154, 0.08), transparent 28%),
                linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    }

    .contacts-page__container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
    }

    .contacts-page__header {
        max-width: 760px;
        margin-bottom: 40px;
    }

    .contacts-page__eyebrow {
        margin: 0 0 12px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #5b6b84;
    }

    .contacts-page__title {
        margin: 0 0 16px;
        font-size: clamp(2.2rem, 4vw, 3.4rem);
        line-height: 1.05;
        color: #0f172a;
    }

    .contacts-page__subtitle {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: #475569;
    }

    .contacts-page__grid {
        display: grid;
        grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);
        gap: 28px;
        align-items: stretch;
    }

    .contacts-card,
    .map-card {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 28px;
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
        backdrop-filter: blur(10px);
    }

    .contacts-card {
        padding: 32px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .contacts-card__top {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .contacts-card__title,
    .map-card__title {
        margin: 0;
        font-size: 1.45rem;
        line-height: 1.2;
        color: #0f172a;
    }

    .contacts-card__text,
    .map-card__text {
        margin: 0;
        line-height: 1.7;
        color: #475569;
    }

    .contacts-list {
        display: grid;
        gap: 18px;
    }

    .contacts-item {
        padding: 18px 20px;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.14);
    }

    .contacts-item__label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #64748b;
    }

    .contacts-item__value {
        margin: 0;
        font-size: 1rem;
        line-height: 1.6;
        color: #0f172a;
    }

    .contacts-item__link {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.6;
        color: #0f172a;
        text-decoration: none;
        transition: color 0.2s ease, opacity 0.2s ease;
    }

    .contacts-item__link:hover {
        color: #1d4ed8;
    }

    .map-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-height: 100%;
    }

    .map-card__header {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .map-card__frame {
        position: relative;
        min-height: 520px;
        overflow: hidden;
        border-radius: 24px;
        background: #dbe4f0;
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .map-card__frame iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    @media (max-width: 960px) {
        .contacts-page__grid {
            grid-template-columns: 1fr;
        }

        .map-card__frame {
            min-height: 420px;
        }
    }

    @media (max-width: 640px) {
        .contacts-page {
            padding: 56px 0 72px;
        }

        .contacts-card,
        .map-card {
            border-radius: 22px;
        }

        .contacts-card {
            padding: 24px;
        }

        .map-card {
            padding: 18px;
        }

        .contacts-item {
            padding: 16px;
            border-radius: 16px;
        }

        .map-card__frame {
            min-height: 340px;
            border-radius: 18px;
        }
    }
</style>