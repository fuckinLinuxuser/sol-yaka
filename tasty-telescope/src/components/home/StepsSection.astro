---
const steps = [
    {
        title: "Получаем заявку",
        text: "Вы оставляете заявку на сайте или связываетесь с нами по телефону для первичной консультации.",
    },
    {
        title: "Подбираем решение",
        text: "Уточняем тип продукции, объём поставки, формат отгрузки, регион и сроки доставки.",
    },
    {
        title: "Согласовываем условия",
        text: "Формируем коммерческое предложение, согласовываем цену, документы и условия поставки.",
    },
    {
        title: "Отгружаем продукцию",
        text: "Организуем поставку и передаём клиенту полный комплект сопроводительных документов.",
    },
];
---

<section class="steps section" id="steps">
    <div class="container">
        <div class="section-heading">
            <span class="section-heading__eyebrow">Как мы работаем</span>
            <h2 class="section-heading__title">Понятный процесс от заявки до поставки</h2>
            <p class="section-heading__text">
                Делаем процесс закупки простым: быстро уточняем задачу, подбираем
                продукцию, согласовываем условия и организуем поставку.
            </p>
        </div>

        <div class="steps__grid">
            {steps.map((step, index) => (
                    <article class="steps__card">
                        <span class="steps__number">{index + 1}</span>
                        <h3 class="steps__title">{step.title}</h3>
                        <p class="steps__text">{step.text}</p>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .steps__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
    }

    .steps__card {
        position: relative;
        padding: 28px;
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
    }

    .steps__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        margin-bottom: 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--color-primary) 0%, #3b82f6 100%);
        color: #ffffff;
        font-size: 20px;
        font-weight: 800;
        box-shadow: 0 14px 32px rgba(37, 99, 235, 0.22);
    }

    .steps__title {
        margin: 0 0 12px;
        font-size: 21px;
        line-height: 1.2;
        font-weight: 800;
        color: var(--color-text);
    }

    .steps__text {
        margin: 0;
        color: var(--color-text-soft);
    }

    @media (max-width: 1100px) {
        .steps__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .steps__grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .steps__card {
            padding: 22px;
        }

        .steps__title {
            font-size: 19px;
        }
    }
</style>