---
const benefits = [
    "Надёжные поставки без срывов сроков",
    "Оптовые цены для бизнеса и предприятий",
    "Доставка по регионам",
    "Работа с юридическими лицами",
    "Полный комплект документов и сертификатов",
    "Персональный менеджер на каждом этапе",
];
---

<section class="section section--soft benefits-section" id="benefits">
    <div class="container">
        <div class="section-head">
            <span class="section-kicker">Преимущества</span>
            <h2>Почему с нами удобно работать</h2>
            <p>
                Строим поставки так, чтобы клиент быстро понимал условия, сроки,
                объёмы и комплект документов без лишних согласований.
            </p>
        </div>

        <div class="benefits-grid">
            {benefits.map((benefit) => (
                    <article class="card benefit-card">
                        <div class="benefit-card__icon" aria-hidden="true">✓</div>
                        <p>{benefit}</p>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .benefits-section {
        position: relative;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .benefit-card {
        min-height: 132px;
        padding: 26px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .benefit-card__icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #dbeafe;
        color: var(--color-primary);
        font-size: 18px;
        font-weight: 800;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .benefit-card p {
        margin: 0;
        color: var(--color-text);
        line-height: 1.65;
        font-weight: 600;
    }

    @media (max-width: 1100px) {
        .benefits-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 767px) {
        .benefits-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .benefit-card {
            min-height: auto;
            padding: 22px;
        }
    }
</style>