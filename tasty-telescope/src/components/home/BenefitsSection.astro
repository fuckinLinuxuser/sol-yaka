---
const benefits = [
    "Надёжные поставки без срывов сроков",
    "Оптовые цены для бизнеса и предприятий",
    "Доставка по регионам",
    "Работа с юридическими лицами",
    "Полный комплект документов и сертификатов",
    "Персональный менеджер на каждом этапе",
];
---

<section class="benefits section" id="benefits">
    <div class="container">
        <div class="section-heading">
            <span class="section-heading__eyebrow">Преимущества</span>
            <h2 class="section-heading__title">Почему с нами удобно работать</h2>
            <p class="section-heading__text">
                Строим поставки так, чтобы клиент быстро понимал условия, сроки, объёмы и
                комплект документов без лишних согласований.
            </p>
        </div>

        <div class="benefits__grid">
            {benefits.map((benefit) => (
                    <article class="benefits__item">
                        <span class="benefits__icon" aria-hidden="true">✓</span>
                        <p class="benefits__text">{benefit}</p>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .benefits {
        background:
                linear-gradient(180deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 1) 100%);
    }

    .benefits__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .benefits__item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 24px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
    }

    .benefits__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.12);
        color: var(--color-primary);
        font-size: 18px;
        font-weight: 800;
    }

    .benefits__text {
        margin: 0;
        font-size: 16px;
        color: var(--color-text);
    }

    @media (max-width: 960px) {
        .benefits__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .benefits__grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .benefits__item {
            padding: 20px;
        }
    }
</style>