---
const industries = [
    {
        title: "Производственные предприятия",
        text: "Поставки соли для технологических процессов, обслуживания оборудования и производственных задач.",
    },
    {
        title: "Пищевая отрасль",
        text: "Решения для пищевого производства, фасовки, переработки и предприятий общественного питания.",
    },
    {
        title: "Водоподготовка и сервис",
        text: "Таблетированная соль для систем водоочистки, фильтрации и инженерной инфраструктуры.",
    },
    {
        title: "Склады и логистика",
        text: "Материалы для эксплуатации объектов, сезонного обслуживания территорий и бесперебойной работы площадок.",
    },
    {
        title: "Дорожные и коммунальные службы",
        text: "Противогололедные материалы для дорог, тротуаров, промышленных и общественных территорий.",
    },
    {
        title: "Оптовые компании и снабжение",
        text: "Регулярные поставки продукции для дальнейшей реализации, комплектации заказов и корпоративных закупок.",
    },
];
---

<section class="industries section" id="industries">
    <div class="container">
        <div class="section-heading">
            <span class="section-heading__eyebrow">Отрасли</span>
            <h2 class="section-heading__title">
                Для каких сфер бизнеса мы поставляем продукцию
            </h2>
            <p class="section-heading__text">
                Работаем с B2B-клиентами, которым важны стабильные поставки, документы,
                понятные условия и возможность закупать нужные объёмы без лишней
                бюрократии.
            </p>
        </div>

        <div class="industries__grid">
            {industries.map((industry) => (
                    <article class="industries-card">
                        <div class="industries-card__top">
                            <span class="industries-card__badge">B2B</span>
                        </div>

                        <h3 class="industries-card__title">{industry.title}</h3>
                        <p class="industries-card__text">{industry.text}</p>

                        <a class="industries-card__link" href="#contacts">
                            Обсудить поставку
                        </a>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .industries {
        background:
                linear-gradient(
                        180deg,
                        rgba(248, 250, 252, 0.72) 0%,
                        rgba(255, 255, 255, 1) 100%
                );
    }

    .industries__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    .industries-card {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        padding: 28px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: #ffffff;
        box-shadow: var(--shadow-sm);
        transition:
                transform var(--transition),
                box-shadow var(--transition),
                border-color var(--transition);
    }

    .industries-card:hover {
        transform: translateY(-4px);
        border-color: rgba(37, 99, 235, 0.22);
        box-shadow: var(--shadow-md);
    }

    .industries-card__top {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        margin-bottom: 18px;
    }

    .industries-card__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.1);
        color: var(--color-primary);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .industries-card__title {
        margin: 0 0 12px;
        font-size: 22px;
        line-height: 1.2;
        font-weight: 800;
        color: var(--color-text);
    }

    .industries-card__text {
        margin: 0;
        color: var(--color-text-soft);
    }

    .industries-card__link {
        margin-top: auto;
        padding-top: 18px;
        font-weight: 700;
        color: var(--color-primary);
    }

    @media (max-width: 1100px) {
        .industries__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .industries__grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .industries-card {
            padding: 22px;
        }

        .industries-card__title {
            font-size: 20px;
        }
    }
</style>