<script>
    const industriesRoot = document.querySelector("[data-industries-slider]");

    if (industriesRoot) {
        const track = industriesRoot.querySelector("[data-industries-track]");
        const prevButton = industriesRoot.querySelector("[data-industries-prev]");
        const nextButton = industriesRoot.querySelector("[data-industries-next]");

        const getStep = () => {
            const card = track?.querySelector(".industry-card");
            if (!card) return 360;
            return card.getBoundingClientRect().width + 24;
        };

        const updateButtons = () => {
            if (!track || !prevButton || !nextButton) return;

            const maxScrollLeft = track.scrollWidth - track.clientWidth - 4;

            prevButton.disabled = track.scrollLeft <= 4;
            nextButton.disabled = track.scrollLeft >= maxScrollLeft;
        };

        prevButton?.addEventListener("click", () => {
            track?.scrollBy({
                left: -getStep(),
                behavior: "smooth",
            });
        });

        nextButton?.addEventListener("click", () => {
            track?.scrollBy({
                left: getStep(),
                behavior: "smooth",
            });
        });

        track?.addEventListener("scroll", updateButtons, { passive: true });
        window.addEventListener("resize", updateButtons);

        updateButtons();
    }
</script>

