---
const products = [
    {
        title: "Пищевая соль",
        text: "Соль для пищевого производства, фасовки, торговли и предприятий общественного питания.",
    },
    {
        title: "Техническая соль",
        text: "Продукция для промышленного применения, обслуживания объектов и технологических процессов.",
    },
    {
        title: "Таблетированная соль",
        text: "Соль для систем водоочистки, фильтрации и промышленного оборудования.",
    },
    {
        title: "Противогололедные реагенты",
        text: "Материалы для обработки дорог, территорий, складов и промышленных площадок.",
    },
];
---

<section class="products section" id="products">
    <div class="container">
        <div class="section-heading">
            <span class="section-heading__eyebrow">Продукция</span>
            <h2 class="section-heading__title">
                Ассортимент продукции для бизнеса и предприятий
            </h2>
            <p class="section-heading__text">
                Подбираем поставки под производственные, торговые, технические и сезонные
                задачи. Работаем с разными объёмами и форматом отгрузки.
            </p>
        </div>

        <div class="products__grid">
            {products.map((product) => (
                    <article class="products__card">
                        <h3 class="products__card-title">{product.title}</h3>
                        <p class="products__card-text">{product.text}</p>
                        <a class="products__card-link" href="#contacts">
                            Подробнее
                        </a>
                    </article>
            ))}
        </div>
    </div>
</section>

<style>
    .products__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
    }

    .products__card {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        padding: 28px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        box-shadow: var(--shadow-sm);
        transition:
                transform var(--transition),
                box-shadow var(--transition),
                border-color var(--transition);
    }

    .products__card:hover {
        transform: translateY(-4px);
        border-color: rgba(37, 99, 235, 0.22);
        box-shadow: var(--shadow-md);
    }

    .products__card-title {
        margin: 0 0 12px;
        font-size: 22px;
        line-height: 1.2;
        font-weight: 800;
        color: var(--color-text);
    }

    .products__card-text {
        margin: 0;
        color: var(--color-text-soft);
    }

    .products__card-link {
        margin-top: auto;
        padding-top: 18px;
        font-weight: 700;
        color: var(--color-primary);
    }

    @media (max-width: 1100px) {
        .products__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .products__grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .products__card {
            padding: 22px;
        }

        .products__card-title {
            font-size: 20px;
        }
    }
</style>