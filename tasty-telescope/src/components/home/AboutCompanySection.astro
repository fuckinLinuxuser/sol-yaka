---
const stats = [
    {
        value: "с 2006",
        label: "на рынке поставок",
    },
    {
        value: "20+ регионов",
        label: "логистика по России",
    },
    {
        value: "Стабильно",
        label: "без срывов поставок",
    },
];

const points = [
    "Пищевая, техническая и таблетированная соль",
    "Поставка под объём и логистику клиента",
    "Стабильные отгрузки для бизнеса",
];
---

<section class="about-company" id="about">
    <div class="container about-company__container">
        <div class="about-company__content">
            <span class="about-company__eyebrow">О компании</span>

            <h2 class="about-company__title">
                Стабильные поставки соли для предприятий и бизнеса
            </h2>

            <p class="about-company__text">
                ООО «Альянс» обеспечивает предприятия, торговые и промышленные компании
                солью для производственных, технических и коммерческих задач — с
                понятными условиями, удобной логистикой и надёжными отгрузками.
            </p>

            <ul class="about-company__points">
                {points.map((item) => (
                        <li>{item}</li>
                ))}
            </ul>

            <div class="about-company__actions">
                <a href="/about" class="btn btn--primary">Подробнее о компании</a>
                <a href="#contacts" class="btn btn--secondary">Обсудить поставку</a>
            </div>
        </div>

        <aside class="about-company__aside">
            <div class="about-company__stats">
                {stats.map((item) => (
                        <article class="about-company__stat">
                            <strong>{item.value}</strong>
                            <span>{item.label}</span>
                        </article>
                ))}
            </div>
        </aside>
    </div>
</section>

<style>
    .about-company {
        position: relative;
        padding: 80px 0;
        background:
                radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 30%),
                linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .about-company__container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
        gap: 28px;
        align-items: stretch;
    }

    .about-company__content {
        padding: 36px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.06);
        backdrop-filter: blur(8px);
    }

    .about-company__eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.08);
        color: #2563eb;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .about-company__title {
        margin: 0 0 18px;
        max-width: 760px;
        font-size: clamp(34px, 4vw, 58px);
        line-height: 1.02;
        letter-spacing: -0.05em;
        color: #0f172a;
    }

    .about-company__text {
        margin: 0 0 24px;
        max-width: 760px;
        font-size: 18px;
        line-height: 1.75;
        color: #475569;
    }

    .about-company__points {
        display: grid;
        gap: 14px;
        margin: 0 0 30px;
        padding: 0;
        list-style: none;
    }

    .about-company__points li {
        position: relative;
        padding-left: 30px;
        font-size: 16px;
        line-height: 1.7;
        color: #0f172a;
        font-weight: 500;
    }

    .about-company__points li::before {
        content: "";
        position: absolute;
        top: 9px;
        left: 0;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #2563eb;
        box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.12);
    }

    .about-company__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .about-company__aside {
        display: flex;
        height: 100%;
    }

    .about-company__stats {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        width: 100%;
    }

    .about-company__stat {
        min-height: 148px;
        padding: 24px;
        border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f1f5ff 100%);
        border: 1px solid rgba(37, 99, 235, 0.12);
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.06);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .about-company__stat strong {
        display: block;
        font-size: 30px;
        line-height: 1.05;
        letter-spacing: -0.04em;
        color: #0f172a;
    }

    .about-company__stat span {
        display: block;
        font-size: 15px;
        line-height: 1.6;
        color: #64748b;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 54px;
        padding: 0 24px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                background 0.2s ease,
                border-color 0.2s ease,
                color 0.2s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn--primary {
        background: #2563eb;
        color: #ffffff;
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.22);
    }

    .btn--primary:hover {
        background: #1d4ed8;
    }

    .btn--secondary {
        background: #ffffff;
        color: #0f172a;
        border: 1px solid rgba(148, 163, 184, 0.24);
    }

    .btn--secondary:hover {
        border-color: rgba(37, 99, 235, 0.24);
        color: #2563eb;
    }

    @media (max-width: 1024px) {
        .about-company__container {
            grid-template-columns: 1fr;
        }

        .about-company__stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 767px) {
        .about-company {
            padding: 72px 0;
        }

        .about-company__content {
            padding: 24px;
            border-radius: 22px;
        }

        .about-company__title {
            font-size: 34px;
            line-height: 1.04;
        }

        .about-company__text {
            font-size: 16px;
            line-height: 1.7;
        }

        .about-company__points li {
            font-size: 15px;
            line-height: 1.65;
        }

        .about-company__actions {
            flex-direction: column;
        }

        .about-company__stats {
            grid-template-columns: 1fr;
        }

        .about-company__stat {
            min-height: 128px;
            border-radius: 20px;
        }

        .btn {
            width: 100%;
        }
    }
</style>