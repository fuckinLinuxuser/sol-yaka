---
const stats = [
    { value: "10+", label: "лет на рынке" },
    { value: "500+", label: "поставок для клиентов" },
    { value: "20+", label: "регионов доставки" },
    { value: "100%", label: "работа по договору" },
];
---

<section class="section section--soft trust-section" id="payment">
    <div class="container">
        <div class="section-head">
            <span class="section-kicker">Доверие и условия</span>
            <h2>Работаем прозрачно, с документами и понятными условиями</h2>
            <p>
                Для B2B-клиента важны не только цена и объём, но и надёжность поставки,
                документы, сопровождение и понятный процесс работы.
            </p>
        </div>

        <div class="trust-stats">
            {stats.map((item) => (
                    <article class="card trust-stat">
                        <div class="trust-stat__value">{item.value}</div>
                        <div class="trust-stat__label">{item.label}</div>
                    </article>
            ))}
        </div>

        <div class="trust-layout">
            <div class="trust-content">
                <h3>Что получает клиент при работе с нами</h3>

                <ul class="trust-list">
                    <li>Работа по договору</li>
                    <li>Сертификаты и сопроводительные документы</li>
                    <li>Коммерческое предложение под ваш объём</li>
                    <li>Согласование сроков, логистики и условий поставки</li>
                    <li>Персональное сопровождение менеджером</li>
                </ul>
            </div>

            <aside class="trust-box">
                <div class="trust-box__title">Запросите прайс и условия поставки</div>

                <p>
                    Подготовим предложение под нужный вид продукции, объём,
                    формат отгрузки и регион доставки.
                </p>

                <a class="btn btn--primary trust-box__btn" href="#contact">
                    Получить прайс
                </a>
            </aside>
        </div>
    </div>
</section>

<style>
    .trust-section {
        position: relative;
    }

    .trust-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .trust-stat {
        padding: 28px;
    }

    .trust-stat__value {
        margin-bottom: 10px;
        font-size: 40px;
        line-height: 1;
        font-weight: 800;
        color: var(--color-primary);
    }

    .trust-stat__label {
        color: var(--color-text-soft);
        line-height: 1.5;
    }

    .trust-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 380px;
        gap: 24px;
        align-items: start;
    }

    .trust-content,
    .trust-box {
        border-radius: var(--radius-lg);
    }

    .trust-content {
        padding: 30px;
        background: #ffffff;
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
    }

    .trust-content h3 {
        margin: 0 0 18px;
        font-size: 28px;
        line-height: 1.15;
        color: var(--color-text);
    }

    .trust-list {
        margin: 0;
        padding-left: 22px;
        color: var(--color-text-soft);
        line-height: 1.9;
    }

    .trust-box {
        padding: 28px;
        background: var(--color-text);
        color: #ffffff;
        box-shadow: var(--shadow-lg);
    }

    .trust-box__title {
        margin-bottom: 12px;
        font-size: 26px;
        line-height: 1.15;
        font-weight: 800;
    }

    .trust-box p {
        margin: 0 0 20px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.8);
    }

    .trust-box__btn {
        width: 100%;
    }

    @media (max-width: 1100px) {
        .trust-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .trust-layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .trust-stats {
            grid-template-columns: 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .trust-stat,
        .trust-content,
        .trust-box {
            padding: 22px;
        }

        .trust-stat__value {
            font-size: 34px;
        }

        .trust-content h3 {
            font-size: 24px;
        }

        .trust-box__title {
            font-size: 22px;
        }
    }
</style>