<section class="intro-hero" id="hero">
    <div class="intro-hero__sticky">
        <div class="intro-hero__bg" aria-hidden="true"></div>

        <div class="intro-hero__overlay" aria-hidden="true"></div>

        <div class="intro-hero__title-wrap" aria-hidden="true">
            <img
                    src="/images/fabric_name.png"
                    alt="ООО Альянс"
                    class="intro-hero__title"
                    id="heroTitle"
                    loading="eager"
                    decoding="async"
            />
        </div>

        <div class="intro-hero__mountain-wrap" aria-hidden="true">
            <img
                    src="/images/salt_mountain.png"
                    alt=""
                    class="intro-hero__mountain"
                    loading="eager"
                    decoding="async"
            />
        </div>

        <div class="intro-hero__scroll">
            <span>Прокрутите вниз</span>
            <div class="intro-hero__scroll-line"></div>
        </div>
    </div>
</section>

<script>
    const hero = document.getElementById("hero");
    const title = document.getElementById("heroTitle");

    if (hero && title) {
        let ticking = false;

        const updateHeroParallax = () => {
            const rect = hero.getBoundingClientRect();
            const heroScroll = Math.max(hero.offsetHeight - window.innerHeight, 1);
            const passed = Math.min(Math.max(-rect.top, 0), heroScroll);
            const progress = passed / heroScroll;

            const eased = 1 - Math.pow(1 - progress, 2.2);

            const moveY = eased * window.innerHeight * 0.72;
            const opacity = 1 - eased * 0.12;
            const scale = 1 - eased * 0.04;
            const blur = eased * 1.2;

            title.style.setProperty("--title-shift", `${moveY}px`);
            title.style.setProperty("--title-opacity", `${opacity}`);
            title.style.setProperty("--title-scale", `${scale}`);
            title.style.setProperty("--title-blur", `${blur}px`);

            ticking = false;
        };

        const requestTick = () => {
            if (!ticking) {
                window.requestAnimationFrame(updateHeroParallax);
                ticking = true;
            }
        };

        updateHeroParallax();
        window.addEventListener("scroll", requestTick, { passive: true });
        window.addEventListener("resize", requestTick);
        window.addEventListener("load", requestTick);
    }
</script>

