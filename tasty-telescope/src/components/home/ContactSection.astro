<section class="contact-section section" id="contacts">
    <div class="container">
        <div class="contact-section__grid">
            <div class="contact-section__content">
                <span class="section-heading__eyebrow">Контакты и заявка</span>
                <h2 class="contact-section__title">
                    Оставьте заявку — подготовим предложение под ваш объём и задачу
                </h2>
                <p class="contact-section__text">
                    Подберём продукцию, рассчитаем стоимость, уточним сроки поставки и
                    предложим удобный формат отгрузки для вашего бизнеса.
                </p>

                <div class="contact-section__info">
                    <div class="contact-section__info-item">
                        <span class="contact-section__info-label">Телефон</span>
                        <div class="contact-section__links">
                            <a href="tel:+78112702529">8 (8112) 70-25-29</a>
                            <a href="tel:+79215080190">8 (921) 508-01-90</a>
                        </div>
                    </div>

                    <div class="contact-section__info-item">
                        <span class="contact-section__info-label">E-mail</span>
                        <a href="mailto:pskov@e-salt.ru">pskov@e-salt.ru</a>
                    </div>

                    <div class="contact-section__info-item">
                        <span class="contact-section__info-label">Режим работы</span>
                        <span>Пн–Пт: 08:00–17:00</span>
                    </div>
                </div>
            </div>

            <div class="contact-section__form-wrap">
                <form class="contact-form">
                    <div class="contact-form__grid">
                        <label class="contact-form__field">
                            <span class="contact-form__label">Имя</span>
                            <input type="text" name="name" placeholder="Ваше имя" />
                        </label>

                        <label class="contact-form__field">
                            <span class="contact-form__label">Телефон</span>
                            <input type="tel" name="phone" placeholder="+7 (___) ___-__-__" />
                        </label>

                        <label class="contact-form__field">
                            <span class="contact-form__label">Компания</span>
                            <input type="text" name="company" placeholder="Название компании" />
                        </label>

                        <label class="contact-form__field contact-form__field--full">
                            <span class="contact-form__label">Комментарий</span>
                            <textarea
                                    name="comment"
                                    rows="5"
                                    placeholder="Какая продукция нужна, объём, город доставки, сроки"
                            ></textarea>
                        </label>
                    </div>

                    <button class="btn btn--primary contact-form__submit" type="submit">
                        Отправить заявку
                    </button>

                    <p class="contact-form__policy">
                        Нажимая кнопку, вы соглашаетесь на обработку персональных данных.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-section {
        background:
                linear-gradient(180deg, rgba(248, 250, 252, 0.84) 0%, rgba(255, 255, 255, 1) 100%);
    }

    .contact-section__grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 32px;
        align-items: start;
    }

    .contact-section__content {
        padding: 32px;
        border-radius: var(--radius-xl);
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        box-shadow: var(--shadow-md);
    }

    .contact-section__content .section-heading__eyebrow {
        color: rgba(255, 255, 255, 0.72);
    }

    .contact-section__title {
        margin: 14px 0 16px;
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.08;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #ffffff;
    }

    .contact-section__text {
        margin: 0;
        max-width: 560px;
        color: rgba(255, 255, 255, 0.82);
    }

    .contact-section__info {
        display: grid;
        gap: 20px;
        margin-top: 32px;
    }

    .contact-section__info-item {
        display: grid;
        gap: 8px;
    }

    .contact-section__info-label {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(255, 255, 255, 0.6);
    }

    .contact-section__info-item a,
    .contact-section__info-item span {
        font-size: 18px;
        font-weight: 600;
        color: #ffffff;
    }

    .contact-section__links {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .contact-section__form-wrap {
        padding: 32px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        background: #ffffff;
        box-shadow: var(--shadow-md);
    }

    .contact-form__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .contact-form__field {
        display: grid;
        gap: 8px;
    }

    .contact-form__field--full {
        grid-column: 1 / -1;
    }

    .contact-form__label {
        font-size: 14px;
        font-weight: 700;
        color: var(--color-text);
    }

    .contact-form input,
    .contact-form textarea {
        width: 100%;
        padding: 16px 18px;
        border: 1px solid var(--color-border);
        border-radius: 16px;
        background: #ffffff;
        color: var(--color-text);
        font: inherit;
        transition:
                border-color var(--transition),
                box-shadow var(--transition);
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
        outline: none;
        border-color: rgba(37, 99, 235, 0.4);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
    }

    .contact-form textarea {
        resize: vertical;
        min-height: 140px;
    }

    .contact-form__submit {
        width: 100%;
        margin-top: 18px;
    }

    .contact-form__policy {
        margin: 14px 0 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--color-text-muted);
    }

    @media (max-width: 960px) {
        .contact-section__grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .contact-section__content,
        .contact-section__form-wrap {
            padding: 22px;
        }

        .contact-form__grid {
            grid-template-columns: 1fr;
        }

        .contact-form__field--full {
            grid-column: auto;
        }

        .contact-section__info-item a,
        .contact-section__info-item span {
            font-size: 16px;
        }
    }
</style>