---
const navItems = [
    { label: "Каталог", href: "/catalog" },
    { label: "Отрасли", href: "/industries" },
    { label: "О компании", href: "/about" },
    { label: "Доставка", href: "/delivery" },
    { label: "Контакты", href: "/contacts" },
];
---

<header class="site-header" id="siteHeader" data-header>
    <div class="site-header__top">
        <div class="container site-header__top-inner">
            <a class="site-header__mail" href="mailto:pskov@e-salt.ru">
                pskov@e-salt.ru
            </a>

            <div class="site-header__top-meta">
        <span class="site-header__schedule">
          Пн–Пт: 08:00–17:00
        </span>

                <a class="site-header__phone" href="tel:+78112702529">
                    8 (8112) 70-25-29
                </a>

                <a class="site-header__phone" href="tel:+79215080190">
                    8 (921) 508-01-90
                </a>
            </div>
        </div>
    </div>

    <div class="site-header__main">
        <div class="container site-header__main-inner">
            <a class="site-header__brand" href="/" aria-label="ООО Альянс — на главную">
                <span class="site-header__brand-mark">A</span>

                <span class="site-header__brand-text">
          <span class="site-header__brand-title">ООО Альянс</span>
          <span class="site-header__brand-subtitle">Оптовые поставки соли</span>
        </span>
            </a>

            <button
                    class="site-header__burger"
                    type="button"
                    aria-label="Открыть меню"
                    aria-expanded="false"
                    aria-controls="site-navigation"
                    data-menu-toggle
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="site-header__nav" id="site-navigation" data-menu>
                <ul class="site-header__nav-list">
                    {navItems.map((item) => (
                            <li class="site-header__nav-item">
                                <a class="site-header__nav-link" href={item.href}>
                                    {item.label}
                                </a>
                            </li>
                    ))}
                </ul>

                <a class="btn btn--primary site-header__cta" href="/contacts">
                    Оставить заявку
                </a>
            </nav>
        </div>
    </div>
</header>

<script>
    const header = document.querySelector("[data-header]");
    const toggleButton = document.querySelector("[data-menu-toggle]");
    const menu = document.querySelector("[data-menu]");
    const hero = document.querySelector("#hero");

    if (header && hero) {
        const updateHeaderState = () => {
            const heroBottom = hero.getBoundingClientRect().bottom;
            const shouldStick = heroBottom <= 0;

            header.classList.toggle("is-sticky", shouldStick);
        };

        updateHeaderState();
        window.addEventListener("scroll", updateHeaderState, { passive: true });
        window.addEventListener("resize", updateHeaderState);
    }

    if (toggleButton && menu) {
        toggleButton.addEventListener("click", () => {
            const isOpen = menu.classList.toggle("is-open");
            toggleButton.setAttribute("aria-expanded", String(isOpen));
            document.body.classList.toggle("menu-open", isOpen);
        });

        const menuLinks = menu.querySelectorAll("a");

        menuLinks.forEach((link) => {
            link.addEventListener("click", () => {
                menu.classList.remove("is-open");
                toggleButton.setAttribute("aria-expanded", "false");
                document.body.classList.remove("menu-open");
            });
        });

        window.addEventListener("resize", () => {
            if (window.innerWidth > 960) {
                menu.classList.remove("is-open");
                toggleButton.setAttribute("aria-expanded", "false");
                document.body.classList.remove("menu-open");
            }
        });
    }
</script>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
        transition:
                transform 0.35s ease,
                opacity 0.35s ease,
                box-shadow 0.35s ease,
                background-color 0.35s ease;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    }

    .site-header.is-sticky {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    .site-header__top {
        border-bottom: 1px solid rgba(226, 232, 240, 0.9);
        background: linear-gradient(
                90deg,
                rgba(248, 250, 252, 0.94) 0%,
                rgba(255, 255, 255, 0.98) 100%
        );
    }

    .site-header__top-inner {
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .site-header__mail,
    .site-header__phone,
    .site-header__schedule {
        font-size: 14px;
        line-height: 1.4;
        color: var(--color-text-soft);
    }

    .site-header__mail,
    .site-header__phone {
        transition: color var(--transition);
    }

    .site-header__mail:hover,
    .site-header__phone:hover {
        color: var(--color-primary);
    }

    .site-header__top-meta {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .site-header__main-inner {
        min-height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .site-header__brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        flex-shrink: 0;
    }

    .site-header__brand-mark {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--color-primary) 0%, #3b82f6 100%);
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        box-shadow: 0 14px 30px rgba(29, 78, 216, 0.22);
    }

    .site-header__brand-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .site-header__brand-title {
        font-size: 18px;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-text);
    }

    .site-header__brand-subtitle {
        margin-top: 3px;
        font-size: 13px;
        line-height: 1.3;
        color: var(--color-text-muted);
    }

    .site-header__nav {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .site-header__nav-list {
        display: flex;
        align-items: center;
        gap: 24px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-header__nav-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text);
        transition: color var(--transition);
    }

    .site-header__nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 8px;
        width: 100%;
        height: 2px;
        border-radius: 999px;
        background: var(--color-primary);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--transition);
    }

    .site-header__nav-link:hover {
        color: var(--color-primary);
    }

    .site-header__nav-link:hover::after {
        transform: scaleX(1);
    }

    .site-header__cta {
        min-width: 178px;
    }

    .site-header__burger {
        display: none;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: #ffffff;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        box-shadow: var(--shadow-sm);
    }

    .site-header__burger span {
        width: 20px;
        height: 2px;
        border-radius: 999px;
        background: var(--color-text);
        transition: transform var(--transition), opacity var(--transition);
    }

    @media (max-width: 960px) {
        .site-header__top {
            display: none;
        }

        .site-header__main-inner {
            min-height: 72px;
        }

        .site-header__burger {
            display: inline-flex;
            flex-shrink: 0;
        }

        .site-header__nav {
            position: absolute;
            top: calc(100% + 1px);
            left: 0;
            right: 0;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 20px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.98);
            border-bottom: 1px solid var(--color-border);
            box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08);
        }

        .site-header__nav.is-open {
            display: flex;
        }

        .site-header__nav-list {
            flex-direction: column;
            align-items: stretch;
            gap: 4px;
        }

        .site-header__nav-item {
            width: 100%;
        }

        .site-header__nav-link {
            width: 100%;
            min-height: 48px;
            padding: 0 4px;
        }

        .site-header__nav-link::after {
            bottom: 6px;
        }

        .site-header__cta {
            width: 100%;
        }
    }

    @media (max-width: 640px) {
        .site-header__brand-mark {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 20px;
        }

        .site-header__brand-title {
            font-size: 16px;
        }

        .site-header__brand-subtitle {
            font-size: 12px;
        }
    }
</style>