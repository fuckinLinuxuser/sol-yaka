---
const navigation = [
    { label: "Главная", href: "#hero" },
    { label: "Услуги", href: "#catalog" },
    { label: "Вакансии", href: "#vacancies" },
    { label: "Контакты", href: "#contacts" },
];
---

<header class="site-anchor-nav" data-anchor-nav>
    <div class="container site-anchor-nav__inner">
        <a class="site-anchor-nav__brand" href="#hero" aria-label="Перейти к началу страницы">
            <span class="site-anchor-nav__brand-mark">A</span>

            <span class="site-anchor-nav__brand-text">
        <strong>ООО Альянс</strong>
        <small>Оптовые поставки соли</small>
      </span>
        </a>

        <nav class="site-anchor-nav__menu" aria-label="Навигация по сайту">
            {navigation.map((item) => (
                    <a
                            class:list={[
                                "site-anchor-nav__link",
                                item.href === "#hero" && "is-active",
                            ]}
                            href={item.href}
                            data-nav-link
                    >
                        {item.label}
                    </a>
            ))}
        </nav>

        <div class="site-anchor-nav__actions">
            <a class="site-anchor-nav__phone" href="tel:+78112702529">
                8 (8112) 70-25-29
            </a>

            <a class="site-anchor-nav__cta btn btn--primary" href="#contacts">
                Связаться
            </a>
        </div>
    </div>
</header>

<script>
    const navRoot = document.querySelector("[data-anchor-nav]");

    if (navRoot) {
        const links = Array.from(navRoot.querySelectorAll("[data-nav-link]"));

        const setActiveLink = (id) => {
            links.forEach((link) => {
                const isActive = link.getAttribute("href") === `#${id}`;
                link.classList.toggle("is-active", isActive);
            });
        };

        const sections = links
            .map((link) => {
                const href = link.getAttribute("href");
                if (!href) return null;
                return document.querySelector(href);
            })
            .filter(Boolean);

        if (sections.length) {
            const observer = new IntersectionObserver(
                (entries) => {
                    const visibleEntries = entries
                        .filter((entry) => entry.isIntersecting)
                        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

                    if (visibleEntries.length > 0) {
                        setActiveLink(visibleEntries[0].target.id);
                    }
                },
                {
                    rootMargin: "-38% 0px -45% 0px",
                    threshold: [0.15, 0.35, 0.55, 0.75],
                }
            );

            sections.forEach((section) => observer.observe(section));
        }
    }
</script>

<style>
    .site-anchor-nav {
        position: sticky;
        top: 0;
        z-index: 80;
        border-bottom: 1px solid rgba(148, 163, 184, 0.22);
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .site-anchor-nav__inner {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 24px;
        min-height: 82px;
    }

    .site-anchor-nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .site-anchor-nav__brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
        color: #ffffff;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: 0.08em;
        box-shadow: 0 14px 30px rgba(29, 78, 216, 0.22);
    }

    .site-anchor-nav__brand-text {
        display: grid;
        gap: 2px;
        min-width: 0;
    }

    .site-anchor-nav__brand-text strong {
        font-size: 16px;
        line-height: 1.1;
        color: #0f172a;
    }

    .site-anchor-nav__brand-text small {
        color: #64748b;
        font-size: 12px;
        line-height: 1.2;
    }

    .site-anchor-nav__menu {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 0;
    }

    .site-anchor-nav__link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 999px;
        color: #475569;
        font-size: 15px;
        font-weight: 700;
        transition:
                color 0.2s ease,
                background 0.2s ease,
                box-shadow 0.2s ease;
    }

    .site-anchor-nav__link:hover {
        color: #0f172a;
        background: rgba(15, 23, 42, 0.05);
    }

    .site-anchor-nav__link.is-active {
        color: #0f172a;
        background: rgba(29, 78, 216, 0.08);
        box-shadow: inset 0 0 0 1px rgba(29, 78, 216, 0.08);
    }

    .site-anchor-nav__actions {
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

    .site-anchor-nav__phone {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        white-space: nowrap;
    }

    .site-anchor-nav__cta {
        min-height: 46px;
        padding: 0 18px;
        white-space: nowrap;
    }

    @media (max-width: 1180px) {
        .site-anchor-nav__inner {
            grid-template-columns: 1fr;
            align-items: stretch;
            gap: 14px;
            padding: 14px 0;
        }

        .site-anchor-nav__menu {
            justify-content: flex-start;
            overflow-x: auto;
            padding-bottom: 2px;
            scrollbar-width: none;
        }

        .site-anchor-nav__menu::-webkit-scrollbar {
            display: none;
        }

        .site-anchor-nav__actions {
            justify-content: space-between;
        }
    }

    @media (max-width: 767px) {
        .site-anchor-nav__inner {
            min-height: auto;
            gap: 12px;
            padding: 12px 0;
        }

        .site-anchor-nav__brand-mark {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 16px;
        }

        .site-anchor-nav__link {
            min-height: 40px;
            padding: 0 14px;
            font-size: 14px;
            white-space: nowrap;
        }

        .site-anchor-nav__actions {
            flex-wrap: wrap;
            gap: 10px;
        }

        .site-anchor-nav__phone {
            font-size: 13px;
        }

        .site-anchor-nav__cta {
            width: 100%;
        }
    }
</style>